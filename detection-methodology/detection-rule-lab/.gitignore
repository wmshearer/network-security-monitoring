# Corpora and engines are fetched, not vendored. They are large, they are
# third-party, and their licenses differ from this project's.
vendor/Zircolite/
data/events/
data/raw/

# Generated run artifacts. Reports themselves ARE committed (they are the
# deliverable); only the bulky intermediate JSON is ignored.
data/out/
*.db
*.sqlite

# Deliberately NOT ignored: reports/*.md and reports/*.json summaries. The
# harness project once lost real evidence to a broad ignore glob, so anything
# that constitutes a result stays tracked.

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
