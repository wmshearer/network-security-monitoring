[general]
serverName = kali
# pass4SymmKey redacted for this evidence copy (auto-generated by Splunk on
# first start, encrypted at rest with this instance's local secret key --
# not sensitive outside this host, but not worth committing either).
pass4SymmKey = $7$REDACTED==

[httpServer]
# mgmtMode defaults to "auto" on a Universal Forwarder, which uses a Unix
# Domain Socket for CLI/management traffic instead of a TCP port. That is
# why `splunk status` reported the process as running and web.conf's
# mgmtHostPort was accepted at startup, but nothing was ever listening on
# TCP 8090 -- confirmed by checking /proc/<splunkd pid>/net/tcp directly,
# which showed no LISTEN socket on 8090 at all. Also confirmed: this key
# belongs under [httpServer], not [general] -- putting it in [general]
# first produced "Invalid key in stanza [general]" at startup. Set to
# "tcp" so the mgmt REST port actually binds over TCP on the port set in
# web.conf (mgmtHostPort = 127.0.0.1:8090), needed here only to prove the
# UF is alive/reachable for this project's evidence; the actual forwarded
# data path is outputs.conf -> indexer:9997, unaffected by this setting.
mgmtMode = tcp

[sslConfig]
sslPassword = $7$REDACTED==

[lmpool:auto_generated_pool_forwarder]
description = auto_generated_pool_forwarder
peers = *
quota = MAX
stack_id = forwarder

[lmpool:auto_generated_pool_free]
description = auto_generated_pool_free
peers = *
quota = MAX
stack_id = free
